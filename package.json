{
  "name": "n8n-nodes-graphorlm",
  "version": "0.1.26",
  "description": "n8n community nodes for Graphor - Intelligent document processing, RAG pipelines, and document chat API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "graphor",
    "graphorlm",
    "rag",
    "retrieval-augmented-generation",
    "document-processing",
    "ai",
    "llm",
    "ocr",
    "document-chat",
    "pdf-extraction",
    "document-extraction",
    "ai-agent",
    "langchain",
    "automation",
    "workflow"
  ],
  "license": "MIT",
  "homepage": "https://graphorlm.com",
  "author": {
    "name": "Graphor",
    "email": "thiago@synapseops.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagohirano/n8n-nodes-graphorlm.git"
  },
  "scripts": {
    "build": "tsc && gulp build:assets",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts'",
    "lintfix": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts' --fix",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GraphorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Graphor/Graphor.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "20.19.41",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "9.39.4",
    "eslint-plugin-n8n-nodes-base": "1.16.6",
    "gulp": "5.0.1",
    "jest": "30.4.2",
    "n8n-workflow": "2.16.0",
    "prettier": "3.7.4",
    "ts-jest": "29.4.9",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.9.7",
  "overrides": {
    "form-data": "4.0.5",
    "lodash": "4.18.1",
    "handlebars": "4.7.9",
    "picomatch": "4.0.4",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.6",
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "flatted": "3.4.2",
    "ajv": "6.15.0"
  }
}
