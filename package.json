{
  "name": "n8n-nodes-graphorlm",
  "version": "0.1.8",
  "description": "n8n community nodes for Graphor - Intelligent document processing, RAG pipelines, and document chat API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "graphor",
    "graphorlm",
    "rag",
    "retrieval-augmented-generation",
    "document-processing",
    "ai",
    "llm",
    "ocr",
    "document-chat",
    "pdf-extraction",
    "document-extraction",
    "ai-agent",
    "langchain",
    "automation",
    "workflow"
  ],
  "license": "MIT",
  "homepage": "https://graphorlm.com",
  "author": {
    "name": "Graphor",
    "email": "support@graphorlm.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thiagohirano/n8n-nodes-graphorlm.git"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts'",
    "lintfix": "eslint 'nodes/**/*.ts' 'credentials/**/*.ts' --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GraphorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Graphor/Graphor.node.js",
      "dist/nodes/Graphor/GraphorTool.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.22.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
