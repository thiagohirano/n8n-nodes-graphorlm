# Local n8n E2E lab settings.
# Copy to e2e/.env and fill secrets locally.

N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_PORT=5678
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_LOG_LEVEL=debug

# Dev-only key used by n8n to decrypt local credentials in e2e/.runtime/n8n.
# The helper scripts generate this in e2e/.env. Keep it empty in git.
N8N_ENCRYPTION_KEY=

# Keep empty in git. Set only in e2e/.env.
GRAPHOR_API_KEY=
